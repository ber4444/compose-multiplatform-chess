<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ML Kit GenAI Prompt API (on-device AI move coach, onDeviceAi module) and its
         transitive genai-common require minSdk 26. The chess app floor is minSdk 24,
         but the coach's MlKitPromptTextGenerator reports Unavailable at runtime on devices
         that don't have AICore (which itself needs Android 13+), so the lower floor is
         safe: on API 24-25 devices the coach deterministically falls back without ever
         touching ML Kit. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Chess">
        <activity
            android:name="com.example.myapplication.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
