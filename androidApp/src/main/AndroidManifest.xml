<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cactus downloads the LLM model from Hugging Face on first launch -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.example.myapplication.ChessApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Chess">
        <!-- Landscape on phones: a square board in portrait leaves most of the screen empty above
             and below it, so the game screen puts its buttons in side rails instead
             (GameScreen.usesSideControls). userLandscape allows both landscape directions and
             honours the user's rotation lock between them. Android 16+ ignores the request on large
             screens (targetSdk 36), where the layout follows the window's shape instead. -->
        <activity
            android:name="com.example.myapplication.MainActivity"
            android:exported="true"
            android:screenOrientation="userLandscape"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
