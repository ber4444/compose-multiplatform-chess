<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Nothing is included or excluded explicitly, so the platform defaults
    apply: settings, the autosaved game and saved-game history all travel with cloud backup and
    device-to-device transfer. Add <exclude> entries here if anything must stay on one device.
-->
<data-extraction-rules>
    <cloud-backup />
</data-extraction-rules>
